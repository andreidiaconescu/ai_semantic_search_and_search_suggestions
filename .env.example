# Dev Postgres (docker-compose `db` service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Test Postgres (docker-compose `test_db` service) — used by tests/conftest.py
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/postgres

# Which EmbeddingProvider to use: local | openai | voyage
EMBEDDING_BACKEND=local

# Only required when EMBEDDING_BACKEND=openai
OPENAI_API_KEY=

# Only required when EMBEDDING_BACKEND=voyage
VOYAGE_API_KEY=
